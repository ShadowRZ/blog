---
import { type CollectionEntry } from 'astro:content';
import Head from '@/components/layouts/Head.astro';

type Props = CollectionEntry<'posts'>;

const head = Astro.props;
---

<!doctype html>
<html lang='en'>
  <Head {...head} />
  <body
    class='flex flex-col min-h-screen bg-ctp-latte-base text-ctp-latte-text dark:bg-ctp-mocha-base dark:text-ctp-mocha-text font-sans antialiased'
  >
    <slot />
  </body>
</html>
