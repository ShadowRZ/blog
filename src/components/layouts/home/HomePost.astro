---
import type { CollectionEntry } from 'astro:content';
import HomePostCommand from './HomePostCommand.astro';
import Category from '../../shared/taxonomies/Category.astro';
import Tag from '../../shared/taxonomies/Tag.astro';

type Props = CollectionEntry<'posts'>;

const { id, data } = Astro.props;
const { title, description, categories, tags } = data;
---

<section class='py-4 flex flex-col gap-2'>
  <HomePostCommand id={id} />
  <h2 class='font-bold text-xl md:text-2xl lg:text-3xl text-ctp-latte-flamingo dark:text-ctp-mocha-flamingo'>
    <a class='hover:underline' href={`/blog/posts/${id}`}>{title}</a>
  </h2>
  <summary class='block text-lg'>{description}</summary>
  <section class='inline-flex gap-2'>
    {categories.map((category) => <Category id={category} />)}
    {tags.map((tag) => <Tag id={tag} />)}
  </section>
</section>
