---
import PostCommand from './PostCommand.astro';
import BackCommand from './BackCommand.astro';
import Category from '@/components/shared/taxonomies/Category.astro';
import Tag from '@/components/shared/taxonomies/Tag.astro';

const { id, title, description, categories, tags } = Astro.props;
---

<header class='relative py-24 px-4 md:px-16 lg:px-32 border-dashed border-b-2 border-ctp-latte-surface-0 dark:border-ctp-mocha-surface-0'>
  <BackCommand />
  <PostCommand id={id} />
  <h1 class='font-bold text-3xl md:text-4xl lg:text-5xl my-4 text-ctp-latte-flamingo dark:text-ctp-mocha-flamingo'>{title}</h1>
  <span class='font-light text-lg md:text-xl lg:text-2xl'>{description}</span>
  <section class='flex gap-2 mt-4'>
    {categories.map((category) => <Category id={category} />)}
    {tags.map((tag) => <Tag id={tag} />)}
  </section>
</header>
